// Solomun – Live at Alexandra Palace, London (2026) (Official Film) 36:40 to 37:00 · 129 cpm · G minor · 9 bars
setcpm(129/4)

drums: s("bd*4, [cp ~ cp ~] [cp ~ cp ~] [~ ~ cp ~] [~ ~ cp ~]").bank("tr909")
// bars 1–9 add these hits (a fill): remove the underscore to hear them
_fills: s("<[~ ~ ~ [~ ~ ~ bd]] ~ ~ ~ ~ ~ ~ ~ ~>, <[~ [~ ~ ~ cp] [cp ~ ~ ~] [cp ~ ~ ~]] ~ ~ ~ ~ ~ ~ ~ ~>, <[[~ oh ~ ~] ~ [~ oh ~ ~] [~ ~ ~ oh]] [[~ oh ~ ~] [~ ~ ~ oh] [~ oh ~ ~] [~ ~ ~ oh]] [[~ oh ~ ~] [~ ~ ~ oh] [~ oh ~ ~] [~ ~ ~ oh]] [[~ oh ~ ~] [~ ~ ~ oh] [~ oh ~ ~] ~] [[~ oh ~ ~] ~ ~ ~] ~ [~ [~ ~ ~ oh] [~ oh ~ ~] [~ ~ ~ oh]] [[~ oh ~ ~] [~ ~ ~ oh] [~ oh ~ ~] [~ ~ ~ oh]] [[~ oh ~ ~] ~ [~ oh ~ ~] [~ ~ ~ oh]]>").bank("tr909")
bass: note("[~ ~ g1@2] [~ g1 ~ g1] [~ ~ g1@2] [~ g1@2 g2]").s("sawtooth").lpf(800)
