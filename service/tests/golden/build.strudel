// Build 0:00 to 0:16 · 123 cpm · A minor · 8 bars
setcpm(123/4)

drums: s("bd*4, [~ cp]*2").bank("tr909")
hats: s("[~ ~ hh ~] [hh ~ hh ~] [hh ~ hh ~] [hh ~ ~ ~], ~ ~ ~ [~ ~ oh ~]").bank("tr909")
bass: note("<[a1@8 c2 ~ e2 a1 g1 ~ e2 d2] [a1@8 g1 a1 d2 ~ e2 c2 a1 ~]>").s("sawtooth").lpf(800)
// bars 6–8 add this under the bass (a build): remove the underscore to hear it (match 0.92 without, 0.91 with)
_bass2: note("[~ a1 a1 a1] a1*4 ~ ~").s("sawtooth").lpf(800).gain(0.6)
