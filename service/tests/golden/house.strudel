// Around The World 1:12 to 1:28 · 126 cpm · A minor · 4 bars
setcpm(126/4)

drums: s("bd*4").bank("tr909")
claps: s("[~ cp]*2").bank("tr909")
hats: s("hh*8, [~ oh]*4").bank("tr909")
bass: note("a1 ~ [a1 ~ a1 ~] [~ e1@2 ~]").s("sawtooth").lpf(800)
chords: chord("<Am F C G>").voicing().s("sawtooth").lpf(1200).room(0.4).gain(0.6)
