// Around The World 1:12 to 1:28 · 160 cpm · D minor · 4 bars
setcpm(160/4)

$: s("<[[bd ~ ~ ~] ~ [~ ~ bd ~] ~] [[bd ~ ~ ~] [~ ~ bd ~] ~ ~]>, [~ sd]*2").bank("tr808")
$: s("hh*16").bank("tr808")
$: chord("Dm").voicing().s("sawtooth").lpf(1200).room(0.4).gain(0.6)
$: note("<[[d4@2 f4@2] ~ a4 ~] [[g4 f4 ~ ~] e4 ~ ~] [d4 ~ ~ ~] [~ ~ ~ [a3@2 ~ ~]]>").s("triangle").gain(0.5)
