// Solomun – Live at Alexandra Palace, London (2026) (Official Film) 48:50 to 49:00 · 129 cpm · D# minor · 5 bars
setcpm(129/4)

drums: s("[~ bd]*4, sd(2,8,1)").bank("tr808")
hats: s("[oh ~ ~ ~] [oh ~ ~ oh] [oh ~ ~ ~] [oh ~ ~ oh]").bank("tr808")
// bars 4–5 add these hits (a fill): remove the underscore to hear them
_fills: s("<~ ~ ~ ~ [~ ~ ~ [~ ~ sd sd]]>, <~ ~ ~ [~ ~ ~ [~ ~ ~ hh]] ~>, <~ ~ ~ ~ [[~ ~ ~ oh] ~ ~ ~]>").bank("tr808")
bass: note("[~ d#2@2 ~] [d#1@3 ~] [e3@3 ~] [d#2@2 ~ ~]").s("sawtooth").lpf(240).lpenv(1.7).lpdecay(0.075).lpsustain(0).attack(0.021).clip(0.57).release(0.037)
chords: chord("<D# Em Em A# A#>").voicing().s("sawtooth").lpf(1200).room(0.4).gain(0.6)
