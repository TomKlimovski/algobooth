// Solomun – Live at Alexandra Palace, London (2026) (Official Film) 48:50 to 49:00 · 129 cpm · D# minor · 5 bars
setcpm(129/4)

drums: s("bd:3*4").bank("tr909")
claps: s("[~ cp:4]*2").bank("tr909")
hats: s("[~ oh:2]*4").bank("tr909").gain(0.61)
ghosts: s("hh:1(2,16,1)").bank("tr909").gain(0.12)
// bars 5–5 add these hits (a fill): remove the underscore to hear them
_fills: s("<~ ~ ~ ~ [[~ hh:1 ~ ~] ~ ~ ~]>").bank("tr909")
bass: note("~@3 d#2@2 ~ d#1@3 ~ e3@3 ~ d#2@2").s("sawtooth").lpf(230).lpenv(1.7).lpdecay(0.065).lpsustain(0).attack(0.021).clip(0.63).release(0.035)
chords: chord("<D# Em Em A# A#>").voicing().s("sawtooth").lpf(1200).room(0.4).gain(0.6)
