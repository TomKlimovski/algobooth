{
  "name": "algobooth",
  "version": "1.0.0",
  "description": "Desktop DJ booth around Strudel",
  "scripts": {
    "dev": "pnpm fetch-samples && vite",
    "build": "pnpm fetch-samples && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "fetch-samples": "tsx scripts/fetch-samples.ts",
    "build-methods": "tsx scripts/build-methods.ts"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@strudel/codemirror": "1.3.0",
    "@strudel/core": "1.2.6",
    "@strudel/draw": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "solid-js": "1.9.17",
    "superdough": "1.3.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.3",
    "jsdom": "26.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.5"
  },
  "private": true,
  "type": "module",
  "pnpm": {
    "patchedDependencies": {
      "@strudel/core@1.2.6": "patches/@strudel__core@1.2.6.patch"
    }
  }
}
